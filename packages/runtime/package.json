{
  "name": "@ironmussa/funny-runtime",
  "version": "0.1.0",
  "private": false,
  "description": "Funny server runtime for agent orchestration, git workflows, and real-time updates.",
  "homepage": "https://github.com/ironmussa/funny/tree/main/packages/runtime",
  "bugs": {
    "url": "https://github.com/ironmussa/funny/issues"
  },
  "license": "MIT",
  "author": "Anthropic",
  "repository": {
    "type": "git",
    "url": "https://github.com/ironmussa/funny.git",
    "directory": "packages/runtime"
  },
  "bin": {
    "funny-server": "./bin/funny-server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./src/app.ts",
    "./lib/auth": "./src/lib/auth.ts",
    "./services/server-interfaces": "./src/services/server-interfaces.ts",
    "./services/service-provider": "./src/services/service-provider.ts",
    "./services/service-registry": "./src/services/service-registry.ts",
    "./services/automation-manager": "./src/services/automation-manager.ts",
    "./services/mcp-oauth": "./src/services/mcp-oauth.ts",
    "./services/ws-broker": "./src/services/ws-broker.ts",
    "./services/grpc-team-transport": "./src/services/grpc-team-transport.ts",
    "./services/grpc-operation-outbox": "./src/services/grpc-operation-outbox.ts",
    "./services/grpc-event-replay-store": "./src/services/grpc-event-replay-store.ts",
    "./services/grpc-terminal-replay-store": "./src/services/grpc-terminal-replay-store.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/dev-watch.ts",
    "dev:test": "bun src/kill-port.ts 3008 && FUNNY_DATA_DIR=.funny-test PORT=3008 CLIENT_PORT=5180 bun --watch src/index.ts",
    "build": "bun run build.ts",
    "start": "bun run dist/index.js",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "test": "bun --bun vitest run",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:bun": "bun --bun vitest run",
    "bench:search": "bun scripts/search-benchmark/run.ts",
    "verify:fff-native": "bun scripts/verify-fff-native.ts",
    "lint:promises": "node ./scripts/lint-promises.mjs src/",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@abbacchio/transport": "^0.2.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@anthropic-ai/sdk": "^0.123.0",
    "@ff-labs/fff-node": "0.10.6",
    "@grpc/grpc-js": "1.14.4",
    "@openai/codex-sdk": "0.153.4",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "assemblyai": "^4.35.0",
    "better-auth": "^1.6.19",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.25",
    "nanoid": "^5.0.9",
    "neverthrow": "^8.2.0",
    "nodemailer": "^9.0.1",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.8",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "winston-transport": "^4.9.0",
    "ws": "^8.19.0",
    "xstate": "^5.32.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@funny/core": "workspace:*",
    "@funny/pipelines": "workspace:*",
    "@funny/shared": "workspace:*",
    "@funny/thread-scheduler": "workspace:*",
    "@funny/workflows": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.18.1",
    "@vscode/ripgrep": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.9",
    "drizzle-kit": "^0.31.9",
    "eslint": "^10.6.0",
    "typescript": "^7.0.2",
    "typescript-eslint-typescript": "npm:typescript@5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "playwright": "^1.50.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
