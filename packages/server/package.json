{
  "name": "@funny/server",
  "version": "0.1.0",
  "private": false,
  "description": "Funny server for team coordination — manages users, projects, memberships, and runner dispatch.",
  "license": "MIT",
  "bin": {
    "funny-server": "./bin/funny-server.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run build.ts",
    "start": "bun run dist/index.js",
    "test": "bun test --isolate",
    "test:coverage": "bun test --coverage --isolate",
    "test:coverage:gate": "bun scripts/coverage-gate.ts"
  },
  "dependencies": {
    "@abbacchio/transport": "^0.2.0",
    "@funny/core": "workspace:*",
    "@funny/shared": "workspace:*",
    "@funny/thread-scheduler": "workspace:*",
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@ironmussa/funny-runtime": "workspace:*",
    "@socket.io/bun-engine": "^0.1.0",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.25",
    "kysely": "^0.29.2",
    "nanoid": "^5.0.9",
    "neverthrow": "^8.2.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.20.0",
    "socket.io": "4.8.3",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.18.0",
    "socket.io-client": "4.8.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
